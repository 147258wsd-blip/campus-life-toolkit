MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/campus-toolkit
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
PORT=5000
ADMIN_USERNAME=campus_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-long-password

# Optional: local SOCKS5 proxy (leave empty on a cloud host)
MONGODB_PROXY_HOST=
MONGODB_PROXY_PORT=
